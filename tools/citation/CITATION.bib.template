% --------------------------------------------------------------------
% CITATION.bib for scikit-plots: how to cite the library.
% Generated by tools/citation/citation_ref.py from its templates; do not
% edit by hand (`python tools/citation/citation_ref.py sync --apply`).
%
% Two entries:
%   {{ latest_key }}
%       every version: the concept DOI, which resolves to the latest one.
%   {{ version_key }}
%       the version this file was generated for ({{ kind }}), with the
%       build and the exact source tree; cite it for reproducibility.
%
% provenance: {{ provenance }}
% --------------------------------------------------------------------
@software{ {{- latest_key }},
  title    = { {{ title }} },
  author   = { {{ author }} },
  year     = { {{ latest_year }} },
  month    = { {{ latest_month }} },
  doi      = { {{ concept_doi }} },
  url      = { {{ repository }} },
  note     = { All versions; the DOI resolves to the latest. Documentation available at \url{ {{ docs_dev }} } },
  license  = { {{ license }} },
  version  = { latest },
  message  = { This is the archived snapshot of latest version of My Research Software },
  keywords = { {{ keywords }} },
}

@software{ {{- version_key }},
  title    = { {{ title }} },
  author   = { {{ author }} },
{%- if version_year %}
  year     = { {{ version_year }} },
  month    = { {{ version_month }} },
{%- endif %}
{%- if version_doi %}
  doi      = { {{ version_doi }} },
{%- endif %}
  url      = { {{ source_url }} },
  note     = { Version {{ version }} ({{ kind }}); {{ build_note }}. All versions: \url{ https://doi.org/{{ concept_doi }} }. Documentation available at \url{ {{ docs }} } },
  license  = { {{ license }} },
  version  = { {{ version }} },
  keywords = { {{ keywords }} },
}
