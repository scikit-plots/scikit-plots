# This is a -*- yaml -*- file
# --------------------------------------------------------------------
# CITATION.cff for scikit-plots (https://citation-file-format.github.io).
# Generated by tools/citation/citation_ref.py from its templates; do not
# edit by hand (`python tools/citation/citation_ref.py sync --apply`).
# version / commit / date-released: the version this file was generated
# for ({{ kind }}) and the commit it was generated from; the concept DOI
# stands for every version and resolves to the latest.
# --------------------------------------------------------------------
cff-version: 1.2.0
title: {{ short_title }}
type: software
message: |-
{%- for line in message.splitlines() %}
  {{ line }}
{%- endfor %}
authors:
  - name: "{{ author }}"
version: "{{ version }}"
{%- if commit %}
commit: "{{ commit }}"
{%- endif %}
{%- if date_released %}
date-released: {{ date_released }}
{%- endif %}
license: {{ license }}
repository-code: {{ repository }}
url: {{ docs }}
keywords:
{%- for word in keywords.split(", ") %}
  - "{{ word }}"
{%- endfor %}

identifiers:
  - type: doi
    description: "All versions of scikit-plots; resolves to the latest"
    value: "{{ concept_doi }}"
{%- if version_doi %}
  - type: doi
    description: "Version {{ version }}"
    value: "{{ version_doi }}"
{%- endif %}
  - type: url
    description: "Source of version {{ version }} ({{ build_note }})"
    value: "{{ source_url }}"

# Associated papers
preferred-citation:
  type: {{ preferred_citation.type }}
  title: "{{ preferred_citation.title }}"
  authors:
    - family-names: "{{ preferred_citation.family_names }}"
      given-names: "{{ preferred_citation.given_names }}"
      orcid: "{{ preferred_citation.orcid }}"
  doi: "{{ preferred_citation.doi }}"
  journal: "NA"
  volume: NA
  start: NA
  end: NA
  year: NA
  url: "{{ preferred_citation.url }}"
