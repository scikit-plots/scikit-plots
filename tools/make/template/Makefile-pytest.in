######################################################################
## pytest release-evidence-slow.prof
######################################################################

## Profile that slowest test before making another change:

# python -m cProfile -o /tmp/release-evidence-slow.prof \
#   -m pytest -q \
#   scikitplot/_externals/_sphinx_ext/_sphinx_ai_assistant/tests/_hf_spaces_proxy/security/test_verify_release_evidence.py::test_release_evidence_rejects_logging_telemetry_and_redis_paper_claims

## Then inspect the cumulative hotspots:

# python - <<'PY'
# import pstats
# pstats.Stats("/tmp/release-evidence-slow.prof").strip_dirs().sort_stats(
#     "cumulative"
# ).print_stats(25)
# PY

######################################################################
## pytest release-evidence-suite.prof
######################################################################

# python -m cProfile -o /tmp/release-evidence-suite.prof \
#   -m pytest -q \
#   scikitplot/_externals/ 2>&1 | tee pytest.log.txt

# This reports the slowest individual tests and helps distinguish expensive test setup from expensive production code.
# If a full rerun is too costly, first run the specific security test modules identified below with --durations=20.

tets-suite:
	python -m cProfile -o /tmp/release-evidence-suite.prof \
	-m pytest -q --durations=40 --durations-min=1 \
	scikitplot/_externals/ 2>&1 | tee pytest.log.txt

######################################################################
## sudo apt install zip
######################################################################

profile:
	python - <<'PY' > /tmp/release-evidence-pstats.txt
	import pstats
	s = pstats.Stats("/tmp/release-evidence-suite.prof")
	s.strip_dirs()
	for title, sort, count in [
		("CUMULATIVE", "cumulative", 60),
		("OWN TIME", "tottime", 60),
		("CALL COUNTS", "calls", 40),
	]:
		print(f"\n=== {title} ===")
		s.sort_stats(sort).print_stats(count)
	PY

	# Package both files so the profile data is available for analysis.
	zip -j release-evidence-profile-analysis.zip \
		/tmp/release-evidence-suite.prof \
		/tmp/release-evidence-pstats.txt

