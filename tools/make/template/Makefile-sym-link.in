# --------------------------------------------------------------------
# Symbolic-link configuration
# --------------------------------------------------------------------

LIB_ROOT := libs
LIBS := \
	annoy \
	cleanprompt \
	corpus \
	cython \
	mcp \
	mlflow \
	rank-bm25 \
	skinny \
	sphinx-ext
SYM_FILES := \
	LICENSE.txt \
	MANIFEST.in
SYM_DIRS := \
	scikitplot

