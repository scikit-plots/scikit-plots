{
    "version": 1,
    "project": "scikit-plots",
    "project_url": "https://scikit-plots.github.io/",
    "repo": "..",
    "branches": [
        "main"
    ],
    "dvcs": "git",
    "environment_type": "virtualenv",
    "build_command": [
        "python -m pip wheel --no-deps -w {build_cache_dir} {build_dir}"
    ],
    "install_command": [
        "in-dir={env_dir} python -m pip install {wheel_file}"
    ],
    "uninstall_command": [
        "return-code=any python -m pip uninstall -y {project}"
    ],
    "matrix": {
        "req": {
            "numpy": [
                ""
            ],
            "scipy": [
                ""
            ],
            "matplotlib": [
                ""
            ],
            "scikit-learn": [
                ""
            ],
            "pandas": [
                ""
            ],
            "seaborn": [
                ""
            ]
        }
    },
    "benchmark_dir": "benchmarks",
    "env_dir": "env",
    "results_dir": "results",
    "html_dir": "html",
    "build_cache_size": 4,
    "show_commit_url": "https://github.com/scikit-plots/scikit-plots/commit/"
}
