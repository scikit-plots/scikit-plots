     "kind": "FINANCIAL",
     "names": [
      "salary",
      "income",
      "wage",
      "wages",
      "bonus",
      "compensation",
      "net_worth",
      "credit_score",
      "balance"
     ],
     "role": "amount"
    },
    {
     "kind": "TAX_ID",
     "names": [
      "ein",
      "vat_number",
      "vat_id",
      "company_tax_id",
      "tax_number"
     ],
     "role": "id",
     "span": "clause"
    }
   ],
   "name": "finance",
   "patterns": [
    {
     "examples_no": [
      "routing number: 011000016"
     ],
     "examples_yes": [
      "routing number: 011000015",
      "ABA 011000015"
     ],
     "intent": "A US ABA routing number with its label, accepted only when its checksum holds.",
     "kind": "ROUTING_NUMBER",
     "pattern": "(?i)\\b(?:routing|aba|rtn)(?:\\s+(?:number|no\\.?))?\\s*[:#]?\\s*(?P<value>\\d{9})\\b",
     "priority": 85,
     "validate": "aba_routing"
    },
    {
     "examples_no": [
      "12-34-56"
     ],
     "examples_yes": [
      "sort code: 12-34-56",
      "Sort Code 123456"
     ],
     "intent": "A UK sort code with its label; the bare shape is also a date.",
     "kind": "SORT_CODE",
     "pattern": "(?i)\\bsort\\s*code\\s*[:#]?\\s*(?P<value>\\d{2}-?\\d{2}-?\\d{2})\\b",
     "priority": 84
    }
   ],
   "summary": "Account and routing numbers, salaries, tax identifiers and card fields.",
   "version": 1
  },
