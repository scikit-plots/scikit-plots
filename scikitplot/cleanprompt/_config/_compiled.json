   "name": "patient",
   "patterns": [
    {
     "examples_no": [
      "943 476 5918"
     ],
     "examples_yes": [
      "943 476 5919",
      "9434765919"
     ],
     "intent": "A UK NHS number, accepted only when its mod-11 check digit is correct.",
     "kind": "NHS_NUMBER",
     "pattern": "\\b\\d{3}[ -]?\\d{3}[ -]?\\d{4}\\b",
     "priority": 87,
     "validate": "nhs_mod11"
    },
    {
     "examples_no": [
      "MRN",
      "MRN: abc"
     ],
     "examples_yes": [
      "MRN: 00412345",
      "medical record number 8812345",
      "patient ID #AB77123"
     ],
     "intent": "A medical record number written with its label.",
