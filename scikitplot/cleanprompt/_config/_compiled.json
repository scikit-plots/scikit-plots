   ],
   "name": "addressbook",
   "patterns": [
    {
     "examples_no": [
      "SW1A",
      "ABCD 1234"
     ],
     "examples_yes": [
      "SW1A 1AA",
      "M1 1AE",
      "EC1A1BB"
     ],
     "intent": "A UK postcode in the Royal Mail format.",
     "kind": "UK_POSTCODE",
     "pattern": "\\b(?:[A-PR-UWYZ][A-HK-Y]?\\d[A-HJKPSTUW\\d]?) ?\\d[ABD-HJLNP-UW-Z]{2}\\b",
     "priority": 70
    }
   ],
   "requires": [
    "personal"
   ],
   "summary": "Contact entries - organisation, role, postal and web details, vCard properties.",
   "version": 1
  },
  "cloud": {
   "fields": [
    {
     "kind": "CLOUD_ID",
     "names": [
      "drive_id",
      "folder_id",
      "file_id",
      "document_id",
      "spreadsheet_id",
      "sheet_id",
      "presentation_id",
      "bucket",
      "bucket_name",
      "project_id",
      "tenant_id",
      "subscription_id",
      "account_id_aws",
      "aws_account_id",
      "resource_group",
      "storage_account"
     ],
     "role": "id",
     "span": "token"
    },
    {
     "kind": "HOST",
     "names": [
      "host",
      "host_name",
      "server",
      "server_name",
      "endpoint",
      "fqdn"
     ],
     "role": "id",
     "span": "token"
    }
   ],
   "name": "cloud",
   "patterns": [
    {
     "examples_no": [
      "arn:aws:iam::role/analyst"
     ],
     "examples_yes": [
      "arn:aws:iam::123456789012:role/analyst"
     ],
     "intent": "An AWS resource name, which carries the twelve-digit account number.",
     "kind": "AWS_ARN",
     "pattern": "\\barn:aws[a-z\\-]*:[a-z0-9\\-]+:[a-z0-9\\-]*:\\d{12}:[^\\s\"'`<>]+",
     "priority": 90
    },
    {
     "examples_no": [
      "DefaultEndpointsProtocol=https;AccountName=acct"
     ],
     "examples_yes": [
      "DefaultEndpointsProtocol=https;AccountName=acct;AccountKey=abc123==;EndpointSuffix=core.windows.net"
     ],
     "intent": "An Azure storage connection string, which contains the account key.",
     "kind": "AZURE_CONNECTION",
     "pattern": "DefaultEndpointsProtocol=https?;AccountName=[^;\\s]+;AccountKey=[^;\\s]+(?:;[^\\s\"']*)?",
     "priority": 96
    }
   ],
   "summary": "Drive, bucket, project, tenant and account identifiers, and cloud connection strings.",
   "version": 1
  },
  "email": {
   "fields": [
    {
     "kind": "MAIL_PARTY",
