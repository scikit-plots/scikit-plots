   "name": "email",
   "patterns": [
    {
     "examples_no": [
      "<not a message id>"
     ],
     "examples_yes": [
      "<CAF=abc123.456@mail.example.com>"
     ],
     "intent": "An RFC 5322 message identifier, which points at one message in one mailbox.",
     "kind": "MESSAGE_ID",
     "pattern": "<[A-Za-z0-9._%+$!#&=~\\-]+@[A-Za-z0-9.\\-]+>",
     "priority": 80
    }
   ],
   "requires": [
