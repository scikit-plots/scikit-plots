"""Contains CITATION.bib contents at the time of building this package."""

######################################################################
## This file is generated by scikitplot's build process
## It contains CITATION.bib contents at the time of building this package.
######################################################################
import json
import pathlib
import re

from scikitplot import logger

_built_with_meson = True

__all__ = [
  "__bibtex__",
  "__citation__",
  "citation",
]

######################################################################
## Create CONFIG by CITATION.bib contents
######################################################################

CITATION = r"""@CITATION@"""

# Set the bibtex entry to the article referenced in CITATION.
def _get_bibtex(
  preferred_type:str = 'software',
  ):
    _bibtex = ''
    try:
        # Attempt to read the CITATION.bib file
        refs = (pathlib.Path(__file__).parent / "../CITATION.bib").read_text().split(f"@{preferred_type}")[1:][0]
        _bibtex = f"@{preferred_type}{refs}" if refs else ""
        logger.debug("_bibtex from file CITATION.bib")
    except FileNotFoundError:
        # If CITATION.bib file is not found,
        # fall back to the defined CITATION text string
        refs = CITATION.split(f"@{preferred_type}")[1:][0]
        _bibtex = f"@{preferred_type}{refs}" if refs else ""
        logger.debug("_bibtex from attr CITATION text")
    except Exception as e:
        # Handle any unexpected errors
        logger.error(f"Unexpected error while reading CITATION.bib: {e}")
    return _bibtex

__bibtex__ = __citation__ = _get_bibtex()

######################################################################
## The citation of the installed build
######################################################################

# Facts from tools/citation/citation_ref.py (its ``fields`` command), embedded
# by config/meson.build: one source for the fields of both citations.
CITATION_FIELDS = r"""@CITATION_FIELDS@"""

# PEP 440, appendix B; a copy of ``_PEP440`` in tools/citation/citation_ref.py
# (a test keeps the two equal; the package does not import from tools/).
_PEP440 = re.compile(
    r"""^v?(?:(?:(?P<epoch>[0-9]+)!)?(?P<release>[0-9]+(?:\.[0-9]+)*)
    (?P<pre>[-_\.]?(?P<pre_l>alpha|a|beta|b|preview|pre|c|rc)[-_\.]?(?P<pre_n>[0-9]+)?)?
    (?P<post>(?:-(?P<post_n1>[0-9]+))|(?:[-_\.]?(?P<post_l>post|rev|r)[-_\.]?(?P<post_n2>[0-9]+)?))?
    (?P<dev>[-_\.]?(?P<dev_l>dev)[-_\.]?(?P<dev_n>[0-9]+)?)?)$""",
    re.VERBOSE | re.IGNORECASE,
)
_SHA = re.compile(r"^[0-9a-f]{7,40}$")
_ISO_DOTTED = re.compile(r"^[0-9]{4}\.[0-9]{2}\.[0-9]{2}$")
_WHICH = ("all", "build")


def _version_kind(version):
    """Return the PEP 440 kind of ``version`` (as ``citation_ref.Provenance.kind``)."""
    match = _PEP440.match(version)
    if match is None:
        raise RuntimeError(
            f"the installed version {version!r} is not a PEP 440 public version"
        )
    if match.group("dev") is not None:
        return "development"
    if match.group("pre") is not None:
        return "pre-release"
    if match.group("post") is not None:
        return "post-release"
    return "release"


def _build_facts(info):
    """
    Return ``(version, build, commit, date)`` from a ``scikitplot.version`` module.

    ``commit`` and ``date`` are both None for a build made without git; a
    module that records only one of them is refused.
    """
    version = info.short_version
    build = info.full_version
    commit = info.git_revision or None
    dotted = info.__version_iso_8601__ or None
    if (commit is None) != (dotted is None):
        raise RuntimeError(
            "scikitplot.version records a commit without its date, or a date "
            "without its commit; rebuild the package"
        )
    if commit is not None and not _SHA.match(commit):
        raise RuntimeError(f"scikitplot.version records an invalid commit {commit!r}")
    if dotted is not None and not _ISO_DOTTED.match(dotted):
        raise RuntimeError(f"scikitplot.version records an invalid date {dotted!r}")
    date = dotted.replace(".", "-") if dotted is not None else None
    return version, build, commit, date


def _version_entry(fields, version, build, commit, date):
    """
    Format the BibTeX entry of one build.

    The same lines as the version entry of ``CITATION.bib.template``; a test
    compares the two.
    """
    kind = _version_kind(version)
    repository = fields["repository"]
    if commit is not None:
        url = f"{repository}/tree/{commit}"
        build_note = f"build {build}, generated from commit {commit[:7]} of {date}"
    else:
        url = repository
        build_note = "generated without git: no commit recorded"
    docs = fields["docs_dev"] if kind == "development" else fields["docs_stable"]
    doi = fields["version_dois"].get(version)
    lines = [
        "@software{scikit-plots_v" + version + ",",
        f"  title    = {{ {fields['title']} }},",
        f"  author   = {{ {fields['author']} }},",
    ]
    if commit is not None:
        lines.append(f"  year     = {{ {date[:4]} }},")
        lines.append(f"  month    = {{ {date[5:7]} }},")
    if doi:
        lines.append(f"  doi      = {{ {doi} }},")
    lines.append(f"  url      = {{ {url} }},")
    lines.append(
        f"  note     = {{ Version {version} ({kind}); {build_note}. All versions: "
        f"\\url{{ https://doi.org/{fields['concept_doi']} }}. "
        f"Documentation available at \\url{{ {docs} }} }},"
    )
    lines.append(f"  license  = {{ {fields['license']} }},")
    lines.append(f"  version  = {{ {version} }},")
    lines.append(f"  keywords = {{ {fields['keywords']} }},")
    lines.append("}")
    return "\n".join(lines) + "\n"


def citation(which="all"):
    """
    Return a BibTeX citation of scikit-plots.

    Parameters
    ----------
    which : {"all", "build"}, default="all"
        ``"all"`` cites every version (the concept DOI, which resolves to the
        latest release); it is :data:`__bibtex__`. ``"build"`` cites the
        installed build: its version and kind, the build version with its
        commit, and the URL of that exact source tree.

    Returns
    -------
    str
        One ``@software`` entry.

    Raises
    ------
    TypeError
        If ``which`` is not a str.
    ValueError
        If ``which`` is not ``"all"`` or ``"build"``.
    RuntimeError
        If the installed build records an invalid version, commit or date.

    See Also
    --------
    __bibtex__ : The entry for every version.

    Notes
    -----
    **User notes.** Cite ``which="build"`` when results must be reproducible:
    a notebook can record exactly what it ran. A build made without git has
    no commit, so its entry has no year or month and its ``url`` is the
    repository. A release gets its own Zenodo DOI only when it was known when
    the package was built. Nothing is read from the network.

    **Developer notes.** The fields come from ``tools/citation/citation_ref.py``
    (``fields``, embedded at build time) and the build facts from
    ``scikitplot.version``, imported only when ``which="build"``. The entry is
    the one ``citation_ref.py render --commit <git_revision> --date <date>``
    writes for that version.

    Examples
    --------
    >>> from scikitplot.config import citation
    >>> citation() == citation("all")
    True
    >>> citation("build").startswith("@software{scikit-plots_v")
    True
    """
    if not isinstance(which, str):
        raise TypeError(f"which must be a str, not {type(which).__name__}")
    if which not in _WHICH:
        raise ValueError(f"which must be one of {_WHICH}, not {which!r}")
    if which == "all":
        return __bibtex__
    from .. import version as info  # noqa: PLC0415 - generated; only "build" needs it

    fields = json.loads(CITATION_FIELDS)
    return _version_entry(fields, *_build_facts(info))

