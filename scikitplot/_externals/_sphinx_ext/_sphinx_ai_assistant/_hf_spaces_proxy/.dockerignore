# Deny-by-default build context: only the runtime unit is sent to Docker.
*
!Dockerfile
!requirements.txt
!requirements.lock
!app.py
!deduplicate_dataset.py
!_utils/
!_utils/**
!_providers/
!_providers/**
!_page_feedback/
!_page_feedback/**
_utils/__pycache__/
_utils/**/__pycache__/
_utils/**/*.pyc
_utils/**/*.pyo
_providers/__pycache__/
_providers/**/__pycache__/
_providers/**/*.pyc
_providers/**/*.pyo

_page_feedback/__pycache__/
_page_feedback/**/__pycache__/
_page_feedback/**/*.pyc
_page_feedback/**/*.pyo
