# Install browser assets alongside the lazily imported Python extension.
install_subdir(
  '_static',
  install_dir: py.get_install_dir() / 'scikitplot/_externals/_sphinx_ext/_sphinx_ai_learn'
)

install_subdir(
  '_templates',
  install_dir: py.get_install_dir() / 'scikitplot/_externals/_sphinx_ext/_sphinx_ai_learn'
)
