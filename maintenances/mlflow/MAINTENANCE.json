  "skill": "plugins/scikitplot-dev/skills/scikitplot-mlflow-dev/SKILL.md",
  "ownership": {
    "owns": "The scikitplot.mlflow integration layer: project/session configuration, provider injection, MLflow import compatibility, managed server command/process lifecycle, readiness probing, session-scoped environment/global-state restoration, security policy integration, facades, workflow/CLI composition, bundled configs, typing surface, and subsystem tests.",
    "does_not_own": "The upstream mlflow package/server implementation, Docker/network infrastructure, generic scikitplot CLI ownership, external PyYAML behavior, OS process semantics, or project packaging outside the mlflow submodule."
  },
  "tiers": {
    "public": {
      "modules": [
        "__init__.py",
        "py.typed"
      ],
      "description": "Stable integration API and typing marker."
    },
    "config_project": {
      "modules": [
        "_config.py",
        "_config.pyi",
        "_project.py",
        "_project.pyi",
        "_env.py",
        "_container.py"
      ],
      "description": "Configuration, project discovery/serialization, environment and container context."
    },
    "integration": {
      "modules": [
        "_custom.py",
        "_compat.py",
        "_utils.py",
        "_facade.py"
      ],
      "description": "Injected-provider seam, upstream MLflow import/version compatibility and thin facades."
    },
    "runtime": {
      "modules": [
        "_server.py",
        "_readiness.py",
        "_session.py",
        "_session.pyi",
        "_security.py"
      ],
      "description": "Managed server lifecycle, readiness, session state, security-policy enforcement and typing."
    },
    "workflow": {
      "modules": [
        "_workflow.py",
        "__main__.py",
        "_cli_caps.py"
      ],
      "description": "Demo workflow, module CLI and installed-version flag compatibility."
