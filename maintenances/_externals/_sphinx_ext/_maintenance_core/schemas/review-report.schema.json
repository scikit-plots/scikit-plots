{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Generated Sphinx extension review report",
  "type": "object",
  "required": ["schema_version", "generated_at", "mode", "subsystems", "summary"],
  "properties": {
    "schema_version": {"const": 1},
    "generated_at": {"type": "string", "minLength": 1},
    "mode": {"const": "independent_then_reconcile"},
    "subsystems": {"type": "array"},
    "summary": {"type": "object"}
  }
}
