{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://scikit-plots.github.io/schemas/ai-assistant-discovery.schema.json",
  "title": "AI assistant non-secret discovery manifest",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_version"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "minimum": 1
    },
    "service": {
      "type": [
        "string",
        "null"
      ]
    },
    "version": {
      "type": [
        "string",
        "null"
      ]
    },
    "models": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "default_model": {
      "type": [
        "string",
        "null"
      ]
    },
    "capabilities": {
      "type": "object"
    },
    "has_credentials": {
      "type": "object",
      "additionalProperties": {
        "type": "boolean"
      }
    },
    "limits": {
      "type": "object"
    },
    "timeouts": {
      "type": "object"
    },
    "endpoints": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "cors_origins": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "allOf": [
    {
      "not": {
        "anyOf": [
          {
            "required": [
              "token"
            ]
          },
          {
            "required": [
              "api_key"
            ]
          },
          {
            "required": [
              "secret"
            ]
          },
          {
            "required": [
              "password"
            ]
          }
        ]
      }
    }
  ]
}
