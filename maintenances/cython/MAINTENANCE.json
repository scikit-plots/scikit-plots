        "validate_template_info",
        "verify_template_assets"
      ],
      "scikitplot/cython/_profiles.py": [
        "PlatformCapabilities",
        "RuntimeCapabilities",
        "resolved_toolchain",
        "runtime_capabilities"
      ],
      "scikitplot/cython/_custom_compiler.py": [
        "CompilerCapabilities",
        "compiler_capabilities",
        "register_compiler",
        "get_compiler"
      ]
    },
    "tests_root": "scikitplot/cython/tests",
    "templates_root": "scikitplot/cython/_templates"
  },
  "boundary_contract": {
    "forbid_module_scope_optional": [
      "Cython",
      "setuptools",
      "numpy",
      "pybind11"
    ],
    "forbid_sibling_scikitplot_imports": true,
    "forbid_runtime_roots": [
      "maintenances",
      "skills"
    ],
    "security_choke_point": "scikitplot/cython/_public.py:_validate_build_security",
    "lazy_toolchain_owner": "scikitplot/cython/_builder.py",
    "cache_fingerprint_owner": "scikitplot/cython/_cache.py:runtime_fingerprint",
    "lock_owner": "scikitplot/cython/_lock.py:build_lock",
    "template_validator": "scikitplot/cython/_templates_api.py:validate_template_info"
  },
  "read_order": [
    "maintenances/cython/MAINTAINING.md",
    "maintenances/cython/_maintenance/FRESH_CHAT_HANDOFF.md",
    "maintenances/cython/_maintenance/STATE.json",
    "maintenances/cython/_maintenance/FAMILY.md",
    "maintenances/cython/_maintenance/VERIFICATION.md"
  ]
}
